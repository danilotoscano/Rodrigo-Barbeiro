rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default safety deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Schedule slots: anyone can check if a slot is available, but can only create if not already booked
    match /schedule_slots/{slotId} {
      allow get, list: if true;
      allow create: if !exists(/databases/$(database)/documents/schedule_slots/$(slotId))
                    && request.resource.data.status == 'confirmed';
      allow update: if false;
    }

    // Appointments: clients can write an appointment during booking
    match /appointments/{appointmentId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.resource.data.status == 'confirmed'
                    && request.resource.data.clientName is string
                    && request.resource.data.clientPhone is string
                    && request.resource.data.date is string
                    && request.resource.data.time is string;
      allow update, delete: if false;
    }

    // Clients: upserted during appointment creation
    match /clients/{clientId} {
      allow get: if true;
      allow create, update: if request.resource.data.name is string
                            && request.resource.data.phone is string
                            && request.resource.data.normalizedPhone == clientId;
      allow delete: if false;
    }
  }
}
